# ── Trained model files (large binaries) ─────────
backend/models/*.pt
backend/models/*.h5
backend/models/*.pb
backend/models/dl_model_meta.json
# Allow lightweight XGBoost model artifacts for seamless deployment
!backend/models/xgb_aqi_model.pkl
!backend/models/city_encoder.pkl
!backend/models/feature_medians.pkl
!backend/models/model_meta.json

# ── Dataset files ─────────────────────────────────
data/*.csv
data/*.zip
data/*.xlsx
# Keep the data/ folder itself
!data/.gitkeep

