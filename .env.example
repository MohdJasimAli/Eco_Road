# ══════════════════════════════════════════════════════════════════
# Eco_Road — Environment Configuration Template
# Copy this file to .env and customize as needed.
# ══════════════════════════════════════════════════════════════════

# ── 1. Air Quality Providers ─────────────────────────────────────
# Open-Meteo Air Quality (PRIMARY):
# - Genuinely Keyless, Open-Source, Free, Worldwide
# - Real-time modeled air quality + 72-hour forecast
# - Docs: https://open-meteo.com/en/docs/air-quality-api
OPEN_METEO_BASE=https://air-quality-api.open-meteo.com/v1/air-quality

# WAQI (World Air Quality Index) Token:
# - FREE official token registration: https://aqicn.org/data-platform/token/
# - Provides real-time physical monitoring station observations
# - 'demo' token is rate-limited but active
WAQI_TOKEN=demo

# OpenWeatherMap Air Pollution API (Secondary / Optional fallback):
# - Free tier (1,000 calls/day): https://openweathermap.org/api
# - Leave blank if not using
OWM_API_KEY=

# ── 2. Geocoding & Worldwide Search ──────────────────────────────
# Provider: 'photon' (Default, Free, Keyless, OpenStreetMap-based) or 'nominatim'
# - Photon docs: https://photon.komoot.io/
GEOCODING_PROVIDER=photon
PHOTON_BASE=https://photon.komoot.io
PHOTON_UA=EcoRoad/2.0 (contact@ecoroad.org)

# Nominatim (Fallback / Reverse geocoding)
NOMINATIM_BASE=https://nominatim.openstreetmap.org
NOMINATIM_UA=EcoRoad-Nav/2.0 (contact@ecoroad.org)

# ── 3. Routing Engine ─────────────────────────────────────────────
# OSRM (Open Source Routing Machine):
# - Genuine road/path routing for pedestrian (foot), bicycle (bike), and vehicle (driving)
# - Default public server: http://router.project-osrm.org
ROUTING_PROVIDER=osrm
OSRM_BASE=http://router.project-osrm.org
ROUTING_TIMEOUT=10

# ── 4. Server & Cache Settings ───────────────────────────────────
HOST=0.0.0.0
PORT=8000
CACHE_TTL_SEC=300

# ── 5. Development Demo Mode ─────────────────────────────────────
# Set to 'true' ONLY if you want to force synthetic demonstration data.
# When 'false' (default), Eco_Road uses 100% genuine real-world station & modeled AQI data.
DEMO_MODE=false
